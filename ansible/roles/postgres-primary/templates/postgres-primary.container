[Unit]
Description=PostgreSQL Primary Database
After=network-online.target
Wants=network-online.target

[Container]
Image={{ postgres_image }}
ContainerName={{ postgres_container_name }}
Environment=POSTGRES_DB={{ postgres_database }}
Environment=POSTGRES_USER={{ postgres_user }}
Environment=POSTGRES_PASSWORD={{ postgres_password }}
Environment=POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
Volume={{ postgres_data_dir }}:/var/lib/postgresql/data:Z
Volume={{ postgres_home_dir }}/init-replica.sql:/tmp/init-replica.sql:Z
PublishPort={{ postgres_port }}:5432
User={{ postgres_uid }}:{{ postgres_gid }}

# PostgreSQL configuration for replication
Environment=POSTGRES_REPLICATION_USER={{ postgres_replication_user }}
Environment=POSTGRES_REPLICATION_PASSWORD={{ postgres_replication_password }}

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target