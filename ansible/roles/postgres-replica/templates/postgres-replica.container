[Unit]
Description=PostgreSQL Replica Database
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/postgres:{{ postgres_version }}
ContainerName={{ postgres_container_name }}
Volume={{ postgres_data_dir }}:/var/lib/postgresql/data:Z
PublishPort={{ postgres_port }}:5432
User=postgres
Group=postgres

# Replica-specific configuration
Environment=POSTGRES_PRIMARY_CONNINFO=host={{ primary_host }} port={{ postgres_port }} user={{ postgres_replication_user }} password={{ postgres_replication_password }}

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target